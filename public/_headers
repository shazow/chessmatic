# Cloudflare (Workers static assets) response headers.
#
# The entry points must always be revalidated so a returning visitor picks up
# each new deploy immediately; everything under /assets/ has a content hash in
# its filename, so it can be cached forever.

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

/registerSW.js
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
